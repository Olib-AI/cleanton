// Cleanton native application UI

import { Theme } from "theme.slint";
import { Panel, Badge, ProgressBar, MetricTile, ActionButton, SidebarItem, FileRow, PlanListRow, ServiceListRow, SuggestionListRow, PackageListRow, FaIcon, SparkBar, Toggle, Checkbox, RowColumns, Spinner, ActivityBar } from "widgets.slint";
import { LineEdit, SpinBox, ScrollView, Palette } from "std-widgets.slint";

export struct PlanActionRow {
    name: string,
    size: string,
    safety: string,
    action-type: string,
    action-icon: string,
    // Recipe id this group maps back to (used to filter the plan on Clean).
    recipe-id: string,
    // Whether this group is selected for cleanup.
    selected: bool,
    // Number of underlying files in this recipe group (e.g. 15022).
    count: int,
    // Muted secondary line, e.g. an example target path.
    detail: string,
}

// One row of the expandable cleanup plan. kind: 0 = recipe group header,
// 1 = individual item under a group, 2 = "+N more" note. Selection truth lives
// in Rust (by action index); these fields are the rendered projection.
export struct PlanListItem {
    kind: int,
    name: string,
    detail: string,
    size: string,
    safety: string,
    count: int,
    selected: bool,
    partial: bool,
    expanded: bool,
    row-visible: bool,
}

// A Docker resource category surfaced in Results, independent of the FS scan.
export struct DockerRow {
    key: string,
    label: string,
    detail: string,
    size: string,
    selected: bool,
    has-reclaimable: bool,
}

// A local Time Machine snapshot surfaced in Results. Deleting a snapshot is
// permanent (APFS snapshots cannot go to the Trash), so rows are unselected by
// default and deletion is two-step confirmed.
export struct SnapshotRow {
    // Raw tmutil date token, e.g. "2026-06-29-120000" (what deletion runs on).
    date: string,
    // Human-formatted date for display, e.g. "2026-06-29 12:00:00".
    label: string,
    // Full identifier, e.g. "com.apple.TimeMachine.2026-06-29-120000.local".
    identifier: string,
    selected: bool,
}

// A review-only suggestion row (duplicate set, large file/folder, or screenshot).
export struct SuggestionRow {
    title: string,
    detail: string,
    size: string,
    icon: string,
    // First/representative path, used for "Reveal in Finder" and the Trash action.
    path: string,
    // Whether the two-step Trash affordance is offered for this row.
    deletable: bool,
}

// One selectable manager in the Packages tab selector.
export struct PkgManagerTab {
    id: string,
    label: string,
    available: bool,
}

// One installed package row in the Packages tab.
export struct PackageRow {
    name: string,
    version: string,
    size: string,
    // Keep checkbox (checked = keep). Unkept packages become removal candidates.
    kept: bool,
    // 0 = kept, 1 = removable, 2 = kept only as a dependency of a kept package.
    state: int,
    // New version string when outdated, else "".
    outdated: string,
    // Number of project files referencing this package (codebase-usage warning).
    used-by-count: int,
    // First/representative referencing path for the detail line.
    used-by: string,
}

// An installed application (Applications tab).
export struct AppListRow {
    name: string,
    version: string,
    bundle-id: string,
    path: string,
    size: string,
    protected: bool,
    // Installed via a Homebrew cask; the uninstall also runs `brew uninstall`.
    brew: bool,
    // Installed from the Mac App Store (the bundle carries a MAS receipt). These
    // bundles are usually root-owned, so the uninstall needs admin rights.
    app-store: bool,
}

// One reviewable leftover of an app uninstall.
export struct LeftoverRow {
    name: string,
    path: string,
    kind: string,
    size: string,
    admin: bool,
    selected: bool,
}

// One surfaced package from the read-only security scan (Security tab):
// new, updated, or changed since the trusted baseline. The only per-row
// action is "Trust" which updates the baseline METADATA file — the package
// itself is never touched.
export struct SecurityRow {
    name: string,
    version: string,
    // RAW AV verdict "clean" | "suspicious" | "malicious" — kept for
    // transparency; the BADGE is driven by assessment-label instead.
    verdict: string,
    // Assessment badge label (shared engine copy): the verdict for alerts,
    // "notice" for uncorroborated rows.
    assessment-label: string,
    // True for alert rows (tamper or corroborated threat); false for the
    // neutral "capabilities noted" notices.
    alert: bool,
    // Muted secondary detail for notice rows with a non-clean raw verdict,
    // e.g. "heuristics: malicious (score 95, uncorroborated)". Empty
    // otherwise.
    heuristic: string,
    // Worst finding severity label, e.g. "critical" ("-" when none).
    severity: string,
    score: int,
    path: string,
    // Which package tree it came from, e.g. "global npm packages".
    source: string,
    // Pre-rendered top findings (shared engine copy), newline-separated.
    findings: string,
    // Baseline change kind label (shared engine copy), e.g. "new",
    // "updated", "changed — no version bump", "unchanged".
    change: string,
    // Shared one-sentence explanation of the change kind.
    notice: string,
    // Short recommended-response verb (shared engine copy), e.g.
    // "Investigate now" / "Verify then trust".
    action-label: string,
    // Concrete review-only next steps (shared engine copy), newline-separated.
    // Advisory — the user runs these; Cleanton never removes anything.
    actions: string,
    // True for the same-version tamper case (the red alarm).
    tamper: bool,
    // True for critical alerts (tamper, or a corroborated malicious
    // assessment).
    critical: bool,
}

export struct ServiceRow {
    id: string,
    name: string,
    kind: string,
    status: string,
    path: string,
    running: bool,
    protected-service: bool,
    // Starts automatically at login/boot (launchd RunAtLoad or a brew service).
    run-at-load: bool,
    // The referenced executable is missing: the plist is a safe-to-remove
    // leftover, so a "Remove" affordance is offered instead of "Disable".
    orphaned: bool,
}

export global AppState {
    in-out property <int> active-screen: 0;
    in-out property <bool> scanning: false;
    in-out property <bool> cleaning: false;
    in-out property <bool> loading-services: false;

    in-out property <string> total-reclaimable: "Not scanned";
    // Number of recipe GROUPS shown in the Results list (tens, not thousands).
    in-out property <int> plan-action-count: 0;
    // Total underlying files folded into those groups (the granular plan size).
    in-out property <int> plan-file-count: 0;
    // Expandable cleanup plan: recipe-group headers + (when expanded) their
    // individual item rows. See PlanListItem.
    in-out property <[PlanListItem]> plan-rows;
    // Selection state. Counts/bytes reflect only the ticked items; Clean acts on
    // exactly these. plan-selected-count is the number of selected individual items.
    in-out property <int> plan-selected-count: 0;
    in-out property <string> plan-selected-reclaimable: "0 B";
    in-out property <bool> plan-all-selected: true;
    // ML-demoted candidates: excluded from the executable plan, never one-click run.
    in-out property <int> held-count: 0;
    in-out property <[PlanActionRow]> held-actions;
    in-out property <string> result-mode: "Not scanned";
    in-out property <bool> plan-ready: false;
    in-out property <bool> confirmation-pending: false;
    in-out property <string> plan-review-status: "Scan or refresh a plan to review cleanup actions.";

    // ── Docker (independent of the filesystem scan root) ──────────────────────
    in-out property <bool> docker-available: false;
    in-out property <string> docker-status: "Not scanned";
    in-out property <string> docker-reclaimable: "0 B";
    in-out property <[DockerRow]> docker-rows;
    in-out property <bool> docker-cleaning: false;

    // ── Time Machine local snapshots (confirm-gated; NOT trash-reversible) ────
    in-out property <bool> snapshot-available: false;
    in-out property <string> snapshot-status: "Not queried";
    in-out property <[SnapshotRow]> snapshot-rows;
    in-out property <int> snapshot-selected-count: 0;
    in-out property <bool> snapshot-deleting: false;
    // Two-step arming: true after "Delete selected", cleared by Confirm/Cancel.
    in-out property <bool> snapshot-delete-pending: false;

    // ── Suggestions (review-only: duplicates + large items) ───────────────────
    in-out property <int> duplicate-count: 0;
    in-out property <string> duplicate-reclaimable: "0 B";
    in-out property <[SuggestionRow]> duplicate-rows;
    in-out property <int> large-item-count: 0;
    in-out property <[SuggestionRow]> large-item-rows;
    in-out property <int> screenshot-count: 0;
    in-out property <string> screenshot-reclaimable: "0 B";
    in-out property <[SuggestionRow]> screenshot-rows;
    in-out property <int> installer-count: 0;
    in-out property <string> installer-reclaimable: "0 B";
    in-out property <[SuggestionRow]> installer-rows;
    // Path of the single suggestion whose two-step Trash action is armed
    // (showing "Confirm"); empty means nothing is armed.
    in-out property <string> suggestion-pending-delete-path;

    // ── Packages (Homebrew / npm / pip / MacPorts) ────────────────────────────
    in-out property <[PkgManagerTab]> package-tabs;
    in-out property <int> active-package-tab: 0;
    in-out property <bool> package-loading: false;
    in-out property <string> package-status: "Not loaded";
    in-out property <string> package-note: "";
    in-out property <[PackageRow]> package-rows;
    in-out property <int> package-count: 0;
    in-out property <string> package-total-size: "0 B";
    in-out property <int> package-outdated-count: 0;
    // True for Homebrew (dependency-graph keep-set analysis available).
    in-out property <bool> package-supports-keepset: false;
    in-out property <int> package-removable-count: 0;
    in-out property <string> package-reclaimable: "0 B";
    in-out property <int> package-kept-dep-count: 0;
    in-out property <bool> package-remove-pending: false;
    in-out property <bool> package-acting: false;
    in-out property <string> package-action-status: "";
    // Second-phase: codebase-usage scan running after the list is shown.
    in-out property <bool> package-usage-scanning: false;

    in-out property <string> rust-size: "0 B";
    in-out property <float> rust-ratio: 0.0;
    in-out property <string> swift-size: "0 B";
    in-out property <float> swift-ratio: 0.0;
    in-out property <string> node-size: "0 B";
    in-out property <float> node-ratio: 0.0;
    in-out property <string> python-size: "0 B";
    in-out property <float> python-ratio: 0.0;
    in-out property <string> docker-size: "0 B";
    in-out property <float> docker-ratio: 0.0;
    in-out property <string> ml-size: "0 B";
    in-out property <float> ml-ratio: 0.0;
    in-out property <string> jvm-size: "0 B";
    in-out property <float> jvm-ratio: 0.0;
    in-out property <string> aitools-size: "0 B";
    in-out property <float> aitools-ratio: 0.0;
    in-out property <string> other-size: "0 B";
    in-out property <float> other-ratio: 0.0;

    in-out property <string> scan-root: "";
    in-out property <string> scan-files-count: "0";
    in-out property <string> scan-dirs-count: "0";
    in-out property <string> scan-bytes: "0 B";
    in-out property <string> scan-warning-count: "0";
    in-out property <string> scan-coverage-status: "Not scanned";
    in-out property <float> scan-progress: 0.0;
    in-out property <string> scan-status: "Ready";

    in-out property <float> clean-progress: 0.0;
    in-out property <string> clean-status: "";
    in-out property <int> execution-attempted-count: 0;
    in-out property <int> execution-skipped-count: 0;
    in-out property <int> execution-failed-count: 0;
    in-out property <string> execution-freed: "0 B";
    in-out property <string> execution-moved: "0 B";

    // Honest disk capacity (statfs-backed; available is an approximate lower bound).
    in-out property <bool> capacity-ready: false;
    in-out property <string> disk-total: "--";
    in-out property <string> disk-used: "--";
    in-out property <float> disk-used-ratio: 0.0;
    in-out property <string> disk-available: "--";
    in-out property <string> disk-purgeable: "--";
    in-out property <string> snapshot-note: "";
    // Real disk-usage history (normalized 0..1 bars). Empty => collecting state.
    in-out property <[float]> usage-history;
    in-out property <bool> usage-history-ready: false;

    // Empty Trash affordance (Trash is not freed until emptied).
    in-out property <bool> empty-trash-pending: false;
    // True only when the Trash actually holds items. The "Empty Trash now"
    // button must stay disabled (and the row must say so) when it is empty.
    in-out property <bool> trash-has-items: false;
    in-out property <string> trash-status: "Trashed items are not freed until the Trash is emptied.";

    in-out property <int> service-count: 0;
    in-out property <int> service-running-count: 0;
    in-out property <string> services-status: "Not loaded";
    in-out property <[ServiceRow]> services;
    // Live filter applied to the displayed services list (counts on the metric
    // tiles always reflect the FULL discovered set, not the filtered subset).
    in-out property <string> service-filter;
    in-out property <bool> service-running-only: false;
    // Hide macOS/Apple-managed protected services (they are locked anyway).
    in-out property <bool> service-hide-protected: false;
    // Show only login/startup items (services with RunAtLoad set).
    in-out property <bool> service-startup-only: false;
    // Two-step Disable arming: holds the id of the single row whose destructive
    // action is currently armed (showing "Confirm"); empty means nothing armed.
    in-out property <string> service-pending-disable-id;
    // Two-step Remove arming for orphaned startup items (missing executable).
    in-out property <string> service-pending-remove-id;
    // Two-step Delete arming for a stopped, unprotected service.
    in-out property <string> service-pending-delete-id;

    // Security tab state (read-only supply-chain scan diffed against the
    // trusted baseline; never destructive).
    in-out property <bool> security-scanning: false;
    in-out property <bool> security-has-report: false;
    in-out property <string> security-progress: "";
    in-out property <float> security-progress-ratio: 0.0;
    // Shared summary copy (SecurityReport::summary_message) — same string in
    // the TUI and the CLI.
    in-out property <string> security-summary: "";
    // Shared banner headline + tone ("danger" | "warning" | "success").
    in-out property <string> security-headline: "";
    in-out property <string> security-banner-tone: "success";
    // True when THIS scan recorded the baseline (first run / re-establish).
    in-out property <bool> security-baseline-established: false;
    // Worst verdict across the surfaced packages.
    in-out property <string> security-worst: "clean";
    in-out property <[SecurityRow]> security-rows;
    in-out property <int> security-flagged-count: 0;
    // Diff counts: known/unchanged (suppressed), new, updated, changed
    // without a version bump (tamper signature), and critical alerts.
    in-out property <int> security-known-count: 0;
    in-out property <int> security-new-count: 0;
    in-out property <int> security-updated-count: 0;
    in-out property <int> security-tamper-count: 0;
    in-out property <int> security-critical-count: 0;

    // Applications tab state.
    in-out property <[AppListRow]> app-rows;
    in-out property <string> app-filter;
    in-out property <bool> apps-loading: false;
    in-out property <bool> apps-hide-system: false;
    in-out property <string> apps-status: "";
    in-out property <string> selected-app-path: "";
    in-out property <string> selected-app-name: "";
    in-out property <[LeftoverRow]> leftover-rows;
    in-out property <string> leftover-total: "0 B";
    in-out property <int> leftover-count: 0;
    in-out property <bool> leftover-loading: false;
    in-out property <bool> uninstall-pending: false;
    in-out property <bool> uninstalling: false;

    // Typed, two-way-bound settings backing the interactive controls on the
    // Settings screen. Populated from CleantonConfig on startup and read back
    // into a CleantonConfig on Save.
    in-out property <string> setting-default-root: "";
    in-out property <int> setting-max-depth: 20;
    in-out property <int> setting-threads: 0;
    in-out property <bool> setting-follow-symlinks: false;
    in-out property <bool> setting-respect-gitignore: true;
    in-out property <bool> setting-exclude-cloud: true;
    in-out property <bool> setting-exclude-volumes: true;
    in-out property <bool> setting-ml: false;
    in-out property <int> setting-max-run-gb: 250;
    in-out property <int> setting-max-action-gb: 100;
    in-out property <string> setting-save-status: "No changes saved yet.";
    // Package version of the running build, filled from CARGO_PKG_VERSION.
    in-out property <string> app-version: "";

    // First-run Full Disk Access guidance. `fda-needs-attention` is set only
    // when a probe positively observed a permission denial; the panel is
    // informational and never blocks the app.
    in-out property <bool> fda-needs-attention: false;
    in-out property <string> fda-lead: "";
    in-out property <[string]> fda-steps: [];
    in-out property <string> fda-note: "";
}

export global AppCallbacks {
    callback start-scan();
    callback start-clean();
    callback request-clean-confirmation();
    callback confirm-clean();
    callback cancel-operation();
    // Expand/collapse a group row, toggle a row's selection (group or item), or
    // select/deselect everything.
    callback plan-row-expand(int);
    callback plan-row-toggle(int);
    callback set-all-plan-selection(bool);
    // Toggle a Docker category and run the confirmed Docker cleanup.
    callback toggle-docker-selection(int);
    callback clean-docker();
    // Time Machine snapshot panel: toggle a row, then the two-step permanent
    // delete (request arms the confirmation, confirm runs tmutil, cancel disarms).
    callback toggle-snapshot-selection(int);
    callback request-snapshot-delete();
    callback confirm-snapshot-delete();
    callback cancel-snapshot-delete();
    // Reveal a suggestion's path in Finder (review-only; never deletes).
    callback reveal-in-finder(string);
    // Move a single suggestion path (duplicate copy, large item, or screenshot)
    // to the Trash after explicit user confirmation. Reuses the engine executor
    // and its protected-path / metadata revalidation guards.
    callback delete-suggestion(string);
    // Packages tab: (re)load the inventory for the active manager.
    callback refresh-packages();
    // Switch the active manager (index into package-tabs) and load it.
    callback select-package-manager(int);
    // Toggle a package's keep flag (by row index), or set all at once.
    callback toggle-package-keep(int);
    callback set-all-package-keep(bool);
    // Two-step removal of the unkept (removable) set.
    callback request-remove-packages();
    callback confirm-remove-packages();
    // Update one package by name, update all outdated, or clean the cache.
    callback update-package(string);
    callback update-all-packages();
    callback clean-package-cache();
    callback refresh-services();
    // Rebuild the displayed services model from the full discovered set using
    // the current filter (case-insensitive name/path match + running-only).
    callback apply-service-filter();
    // Safely disable a launchd/Homebrew service by id (protected services are
    // refused in the backend as defense in depth).
    callback disable-service(string);
    // Enable (start at login/boot) a previously disabled service by id.
    callback enable-service(string);
    // Remove an orphaned startup item's leftover plist by id (backend only
    // permits this when the referenced executable is missing).
    callback remove-service(string);
    // Delete a stopped, unprotected service's startup item by id. The backend
    // refuses protected services and anything that is currently running.
    callback delete-service(string);

    // Security tab: start (or restart) the read-only supply-chain scan of
    // installed packages. Detection + notification only; never destructive.
    callback start-security-scan();
    // Record the CURRENT package set as the trusted baseline (a scan that
    // ends by writing the baseline metadata file; packages untouched).
    callback security-establish-baseline();
    // Mark the flagged package at this row index as reviewed/trusted, or all
    // of them. Baseline metadata only — never modifies a package.
    callback security-trust-package(int);
    callback security-trust-all();

    // Applications tab: inventory, leftover review, and two-step uninstall.
    callback refresh-apps();
    callback apply-app-filter();
    callback select-app(string);
    callback toggle-leftover(int);
    callback confirm-uninstall();
    callback request-empty-trash-confirmation();
    callback empty-trash();
    // Opens System Settings → Privacy & Security → Full Disk Access. Gated
    // behind an explicit user click.
    callback open-fda-settings();
    callback dismiss-fda();
    // Persist the edited Settings controls to disk and apply them to the
    // running app (so the next scan uses them).
    callback save-settings();
    // Restore the Settings controls to built-in defaults (persisted on Save).
    callback reset-settings();
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.palette.border-subtle;
}

// One labelled settings row: a title + optional description on the left and the
// interactive control (passed as a child) aligned to the right.
component SettingsField inherits HorizontalLayout {
    in property <string> label;
    in property <string> description;

    spacing: Theme.spacing-lg;
    min-height: 48px;

    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        alignment: center;

        Text {
            text: root.label;
            color: Theme.palette.text-primary;
            font-size: Theme.font-size-sm;
            font-weight: 600;
        }

        if root.description != "": Text {
            text: root.description;
            color: Theme.palette.text-muted;
            font-size: Theme.font-size-xs;
            wrap: word-wrap;
        }
    }

    @children
}

component SectionHeader inherits Text {
    color: Theme.palette.text-muted;
    font-size: Theme.font-size-xs;
    font-weight: 700;
    // letter-spacing isn't a Slint Text property; uppercase conveys the section.
}

export component AppWindow inherits Window {
    // Std-widgets controls (LineEdit, SpinBox) take their text/selection
    // colours from Palette, not from Theme: without this they render dark
    // text on the dark surface and are unreadable in dark mode.
    title: "Cleanton";
    // (A `Palette.color-scheme: ...` binding is not valid Slint; assign it
    // in init and whenever the theme switch flips, below.)
    init => { Palette.color-scheme = Theme.dark-mode ? ColorScheme.dark : ColorScheme.light; }
    min-width: 980px;
    min-height: 660px;
    preferred-width: 1120px;
    preferred-height: 760px;
    background: Theme.palette.base;

    HorizontalLayout {
        Rectangle {
            width: 224px;
            background: Theme.palette.sidebar;

            VerticalLayout {
                padding: Theme.spacing-md;
                spacing: Theme.spacing-sm;

                HorizontalLayout {
                    height: 42px;
                    spacing: Theme.spacing-sm;

                    Rectangle {
                        width: 30px;
                        Image {
                            // Centred against the two-line wordmark ("Cleanton" +
                            // "by Olib AI").
                            y: 6px;
                            source: @image-url("assets/app-icon.png");
                            width: 30px;
                            height: 30px;
                            image-fit: contain;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;

                        Text {
                            text: "Cleanton";
                            color: Theme.palette.text-primary;
                            font-size: Theme.font-size-lg;
                            font-weight: 700;
                        }

                        Text {
                            text: "by Olib AI";
                            color: Theme.palette.text-muted;
                            font-size: Theme.font-size-xs;
                            font-weight: 500;
                        }
                    }
                }

                SidebarItem { label: "Dashboard"; icon-glyph: "\u{f200}"; active: AppState.active-screen == 0; clicked => { AppState.active-screen = 0; } }
                SidebarItem { label: "Results"; icon-glyph: "\u{f0ae}"; active: AppState.active-screen == 1; clicked => { AppState.active-screen = 1; } }
                SidebarItem { label: "Packages"; icon-glyph: "\u{f1b3}"; active: AppState.active-screen == 2; clicked => { AppState.active-screen = 2; AppCallbacks.refresh-packages(); } }
                SidebarItem { label: "Services"; icon-glyph: "\u{f233}"; active: AppState.active-screen == 3; clicked => { AppState.active-screen = 3; AppCallbacks.refresh-services(); } }
                SidebarItem { label: "Applications"; icon-glyph: "\u{e196}"; active: AppState.active-screen == 5; clicked => { AppState.active-screen = 5; AppCallbacks.refresh-apps(); } }
                SidebarItem { label: "Security"; icon-glyph: "\u{f132}"; active: AppState.active-screen == 6; clicked => { AppState.active-screen = 6; } }
                SidebarItem { label: "Settings"; icon-glyph: "\u{f013}"; active: AppState.active-screen == 4; clicked => { AppState.active-screen = 4; } }

                Rectangle { vertical-stretch: 1; }

                Rectangle {
                    height: 1px;
                    background: Theme.palette.border-subtle;
                }

                // One fixed-height row so the icon, the label and the switch are
                // all vertically centred on the same line (a layout puts a
                // fixed-height child at the top edge, which left the switch
                // visibly higher than the label).
                HorizontalLayout {
                    height: 32px;
                    spacing: Theme.spacing-sm;

                    FaIcon {
                        // Icon reflects the CURRENT theme, matching the label:
                        // Light → sun, Dark → moon.
                        glyph: Theme.dark-mode ? "\u{f186}" : "\u{f185}";
                        icon-color: Theme.palette.text-muted;
                        icon-size: Theme.font-size-sm;
                        width: 18px;
                        height: 32px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: Theme.dark-mode ? "Dark" : "Light";
                        color: Theme.palette.text-secondary;
                        font-size: Theme.font-size-sm;
                        height: 32px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    ActionButton {
                        label: "Switch";
                        primary: false;
                        min-width: 72px;
                        height: 32px;
                        clicked => {
                            Theme.dark-mode = !Theme.dark-mode;
                            Palette.color-scheme = Theme.dark-mode ? ColorScheme.dark : ColorScheme.light;
                        }
                    }
                }
            }
        }

        Rectangle { width: 1px; background: Theme.palette.border-subtle; }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.palette.base;

            if AppState.active-screen == 0: VerticalLayout {
                padding: Theme.spacing-xl;
                spacing: Theme.spacing-lg;

                // First-run / permission banner: only shown when Full Disk
                // Access is positively detected as missing. Purely informational
                // — it guides the user and offers a button that opens the
                // correct System Settings pane on explicit click.
                HorizontalLayout {
                    spacing: Theme.spacing-md;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.spacing-xs;
                        Text { text: "Dashboard"; color: Theme.palette.text-primary; font-size: Theme.font-size-xl; font-weight: 700; }
                        Text { text: "Scan root: " + AppState.scan-root; color: Theme.palette.text-secondary; font-size: Theme.font-size-sm; overflow: elide; }
                    }

                    ActionButton {
                        label: AppState.scanning ? "Scanning..." : "Start Scan";
                        icon-glyph: "\u{f002}";
                        enabled: !AppState.scanning && !AppState.cleaning;
                        clicked => { AppCallbacks.start-scan(); }
                    }

                    ActionButton {
                        label: "Cancel";
                        icon-glyph: "\u{f04d}";
                        primary: false;
                        button-color: Theme.palette.danger;
                        enabled: AppState.scanning || AppState.cleaning;
                        clicked => { AppCallbacks.cancel-operation(); }
                    }
                }

                // Everything below the header scrolls: on short windows the
                // tiles and panels keep their natural size instead of being
                // compressed until text clips.
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: Theme.spacing-lg;

                        if AppState.fda-needs-attention: Panel {
                            VerticalLayout {
                                padding: Theme.spacing-lg;
                                spacing: Theme.spacing-md;

                                HorizontalLayout {
                                    spacing: Theme.spacing-sm;
                                    FaIcon { glyph: "\u{f023}"; icon-color: Theme.palette.accent; icon-size: Theme.font-size-md; width: 22px; }
                                    Text {
                                        text: "Unlock a complete scan with Full Disk Access";
                                        color: Theme.palette.text-primary;
                                        font-size: Theme.font-size-md;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }

                                Text {
                                    text: AppState.fda-lead;
                                    color: Theme.palette.text-secondary;
                                    font-size: Theme.font-size-sm;
                                    wrap: word-wrap;
                                }

                                VerticalLayout {
                                    spacing: Theme.spacing-sm;
                                    for step[i] in AppState.fda-steps: HorizontalLayout {
                                        spacing: Theme.spacing-sm;
                                        alignment: start;
                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: Theme.palette.accent;
                                            Text {
                                                text: "\{i + 1}";
                                                color: #FFFFFF;
                                                font-size: Theme.font-size-xs;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: step;
                                            color: Theme.palette.text-primary;
                                            font-size: Theme.font-size-sm;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Text {
                                    text: AppState.fda-note;
                                    color: Theme.palette.text-muted;
                                    font-size: Theme.font-size-xs;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: Theme.spacing-md;
                                    ActionButton {
                                        label: "Open Full Disk Access settings";
                                        icon-glyph: "\u{f013}";
                                        clicked => { AppCallbacks.open-fda-settings(); }
                                    }
                                    ActionButton {
                                        label: "Dismiss";
                                        primary: false;
                                        clicked => { AppCallbacks.dismiss-fda(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }


                        HorizontalLayout {
                            spacing: Theme.spacing-md;

                            MetricTile { label: "Reclaimable"; value: AppState.total-reclaimable; detail: AppState.result-mode; icon-glyph: "\u{f2ed}"; accent-color: Theme.palette.success; ratio: AppState.plan-action-count > 0 ? 1.0 : 0.0; }
                            MetricTile { label: "Recipe groups"; value: AppState.plan-action-count; detail: AppState.plan-file-count + " files in " + AppState.plan-action-count + " groups"; icon-glyph: "\u{f0ae}"; accent-color: Theme.palette.accent; ratio: AppState.plan-action-count > 0 ? 1.0 : 0.0; }
                            MetricTile { label: "Scanned"; value: AppState.scan-bytes; detail: AppState.scan-files-count + " files, " + AppState.scan-warning-count + " warnings"; icon-glyph: "\u{f07b}"; accent-color: Theme.palette.info; ratio: AppState.scan-progress; }
                        }

                        Panel {
                            VerticalLayout {
                                padding: Theme.spacing-lg;
                                spacing: Theme.spacing-md;

                                HorizontalLayout {
                                    Text { text: "Cleanable Categories"; color: Theme.palette.text-primary; font-size: Theme.font-size-lg; font-weight: 700; horizontal-stretch: 1; }
                                    Text { text: AppState.scan-status; color: Theme.palette.text-muted; font-size: Theme.font-size-sm; vertical-alignment: center; }
                                    // Carousel paging: one "page" is three tiles.
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: Theme.radius-sm;
                                        background: prev-touch.has-hover ? Theme.palette.surface-elevated : transparent;
                                        FaIcon { glyph: "\u{f053}"; icon-color: Theme.palette.text-secondary; icon-size: Theme.font-size-sm; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                        prev-touch := TouchArea {
                                            clicked => { category-carousel.viewport-x = min(category-carousel.viewport-x + 3 * 224px, 0); }
                                        }
                                    }
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: Theme.radius-sm;
                                        background: next-touch.has-hover ? Theme.palette.surface-elevated : transparent;
                                        FaIcon { glyph: "\u{f054}"; icon-color: Theme.palette.text-secondary; icon-size: Theme.font-size-sm; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                        next-touch := TouchArea {
                                            clicked => { category-carousel.viewport-x = max(category-carousel.viewport-x - 3 * 224px, min(category-carousel.width - category-carousel.viewport-width, 0)); }
                                        }
                                    }
                                }

                                // Carousel: one horizontally scrollable row of
                                // full-size tiles (trackpad-swipeable; chevrons in
                                // the header page by three). Fixed tile width keeps
                                // every card readable at any window size.
                                // Flickable, not ScrollView: swipes like a
                                // carousel but draws no scrollbar over the cards;
                                // the header chevrons are the paging affordance.
                                category-carousel := Flickable {
                                    // Height matches the fixed tile height, and
                                    // viewport-height is pinned to it so the
                                    // carousel only ever scrolls horizontally
                                    // (tiles are 116px tall — see MetricTile).
                                    height: 116px;
                                    viewport-height: self.height;

                                    HorizontalLayout {
                                        spacing: Theme.spacing-md;
                                        alignment: start;
                                        MetricTile { width: 210px; label: "Rust"; value: AppState.rust-size; detail: "target directories"; icon-glyph: "\u{e07a}"; brand-icon: true; accent-color: Theme.palette.rust; ratio: AppState.rust-ratio; }
                                        MetricTile { width: 210px; label: "Swift"; value: AppState.swift-size; detail: "DerivedData"; icon-glyph: "\u{f8e1}"; brand-icon: true; accent-color: Theme.palette.swift; ratio: AppState.swift-ratio; }
                                        MetricTile { width: 210px; label: "Node"; value: AppState.node-size; detail: "node_modules"; icon-glyph: "\u{f3d3}"; brand-icon: true; accent-color: Theme.palette.node; ratio: AppState.node-ratio; }
                                        MetricTile { width: 210px; label: "Python"; value: AppState.python-size; detail: "virtualenvs and caches"; icon-glyph: "\u{f3e2}"; brand-icon: true; accent-color: Theme.palette.python; ratio: AppState.python-ratio; }
                                        MetricTile { width: 210px; label: "Docker"; value: AppState.docker-size; detail: "images and volumes"; icon-glyph: "\u{f395}"; brand-icon: true; accent-color: Theme.palette.docker; ratio: AppState.docker-ratio; }
                                        MetricTile { width: 210px; label: "ML / AI"; value: AppState.ml-size; detail: "models and checkpoints"; icon-glyph: "\u{e1ec}"; accent-color: Theme.palette.ml; ratio: AppState.ml-ratio; }
                                        MetricTile { width: 210px; label: "JVM / Android"; value: AppState.jvm-size; detail: "Gradle and IDE caches"; icon-glyph: "\u{f17b}"; brand-icon: true; accent-color: Theme.palette.jvm; ratio: AppState.jvm-ratio; }
                                        MetricTile { width: 210px; label: "AI Tools"; value: AppState.aitools-size; detail: "agent caches and worktrees"; icon-glyph: "\u{f544}"; accent-color: Theme.palette.ai-tools; ratio: AppState.aitools-ratio; }
                                        MetricTile { width: 210px; label: "Other"; value: AppState.other-size; detail: "system, apps, more languages"; icon-glyph: "\u{f0c7}"; accent-color: Theme.palette.other; ratio: AppState.other-ratio; }
                                    }
                                }
                            }
                        }

                        Panel {
                            VerticalLayout {
                                padding: Theme.spacing-lg;
                                spacing: Theme.spacing-md;

                                HorizontalLayout {
                                    spacing: Theme.spacing-sm;
                                    FaIcon { glyph: "\u{f0a0}"; icon-color: Theme.palette.info; icon-size: Theme.font-size-md; width: 22px; vertical-alignment: center; }
                                    Text { text: "Disk Capacity"; color: Theme.palette.text-primary; font-size: Theme.font-size-lg; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: AppState.capacity-ready ? "" : "Unavailable"; color: Theme.palette.warning; font-size: Theme.font-size-sm; vertical-alignment: center; }
                                }

                                HorizontalLayout {
                                    spacing: Theme.spacing-xl;
                                    VerticalLayout { spacing: Theme.spacing-xs; Text { text: "Total"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; } Text { text: AppState.disk-total; color: Theme.palette.text-primary; font-size: Theme.font-size-lg; font-weight: 700; } }
                                    VerticalLayout { spacing: Theme.spacing-xs; Text { text: "Used"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; } Text { text: AppState.disk-used; color: Theme.palette.text-primary; font-size: Theme.font-size-lg; font-weight: 700; } }
                                    VerticalLayout { spacing: Theme.spacing-xs; Text { text: "Available (approx)"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; } Text { text: AppState.disk-available; color: Theme.palette.success; font-size: Theme.font-size-lg; font-weight: 700; } }
                                    VerticalLayout { spacing: Theme.spacing-xs; Text { text: "Purgeable (est)"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; } Text { text: AppState.disk-purgeable; color: Theme.palette.text-secondary; font-size: Theme.font-size-lg; font-weight: 700; } }
                                    Rectangle { horizontal-stretch: 1; }
                                }

                                ProgressBar { progress: AppState.disk-used-ratio; }

                                Text { text: "Disk usage history (used bytes per recorded sample)"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; }

                                Rectangle {
                                    height: 48px;

                                    if AppState.usage-history-ready: HorizontalLayout {
                                        alignment: start;
                                        spacing: 1px;
                                        for h in AppState.usage-history: SparkBar { value: h; }
                                    }

                                    if !AppState.usage-history-ready: Text {
                                        text: "Collecting usage history... (need ≥2 samples)";
                                        color: Theme.palette.text-muted;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                    }
                                }

                                if AppState.snapshot-note != "": HorizontalLayout {
                                    spacing: Theme.spacing-sm;
                                    FaIcon { glyph: "\u{f05a}"; icon-color: Theme.palette.text-muted; icon-size: Theme.font-size-sm; width: 16px; }
                                    Text { text: AppState.snapshot-note; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                }
            }

            if AppState.active-screen == 1: VerticalLayout {
                padding: Theme.spacing-xl;
                spacing: Theme.spacing-md;

                HorizontalLayout {
                    Text { text: "Results"; color: Theme.palette.text-primary; font-size: Theme.font-size-xl; font-weight: 700; horizontal-stretch: 1; }
                    ActionButton { label: "Refresh Plan"; icon-glyph: "\u{f15c}"; enabled: !AppState.scanning && !AppState.cleaning; clicked => { AppCallbacks.start-clean(); } }
                }

                Panel {
                    HorizontalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-xl;
                        VerticalLayout { spacing: Theme.spacing-xs; Text { text: "Recipe groups"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; } Text { text: AppState.plan-action-count; color: Theme.palette.text-primary; font-size: Theme.font-size-lg; font-weight: 700; } Text { text: AppState.plan-file-count + " files"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; } }
                        VerticalLayout { spacing: Theme.spacing-xs; Text { text: "Reclaimable"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; } Text { text: AppState.total-reclaimable; color: Theme.palette.success; font-size: Theme.font-size-lg; font-weight: 700; } }
                        VerticalLayout { spacing: Theme.spacing-xs; Text { text: "Selected"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; } Text { text: AppState.plan-selected-reclaimable; color: Theme.palette.accent; font-size: Theme.font-size-lg; font-weight: 700; } Text { text: AppState.plan-selected-count + " items"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; } }
                        VerticalLayout { horizontal-stretch: 1; spacing: Theme.spacing-xs; Text { text: "Mode"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; } Text { text: AppState.result-mode; color: Theme.palette.text-secondary; font-size: Theme.font-size-sm; wrap: word-wrap; } }
                    }
                }

                Panel {
                    VerticalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-sm;

                        HorizontalLayout {
                            spacing: Theme.spacing-md;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: Theme.spacing-xs;
                                Text { text: "Review"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; font-weight: 700; }
                                Text { text: AppState.plan-review-status; color: Theme.palette.text-primary; font-size: Theme.font-size-sm; wrap: word-wrap; }
                                Text { text: AppState.clean-status; color: Theme.palette.text-secondary; font-size: Theme.font-size-sm; wrap: word-wrap; }
                            }

                            ActionButton {
                                label: AppState.confirmation-pending
                                    ? "Confirm Clean (" + AppState.plan-selected-count + ")"
                                    : "Clean selected";
                                icon-glyph: AppState.confirmation-pending ? "\u{f00c}" : "\u{f2ed}";
                                button-color: AppState.confirmation-pending ? Theme.palette.danger : Theme.palette.warning;
                                enabled: !AppState.scanning && !AppState.cleaning && (AppState.confirmation-pending || (AppState.plan-ready && AppState.plan-selected-count > 0));
                                clicked => {
                                    if AppState.confirmation-pending {
                                        AppCallbacks.confirm-clean();
                                    } else {
                                        AppCallbacks.request-clean-confirmation();
                                    }
                                }
                            }
                        }

                        // Execution metrics only appear once a cleanup is running
                        // or has run — before that they're an empty block of zeros.
                        if AppState.cleaning || AppState.execution-attempted-count > 0: VerticalLayout {
                            spacing: Theme.spacing-sm;

                            ProgressBar { progress: AppState.clean-progress; }

                            HorizontalLayout {
                                spacing: Theme.spacing-md;
                                MetricTile { label: "Attempted"; value: AppState.execution-attempted-count; detail: "Execution actions"; icon-glyph: "\u{f04b}"; accent-color: Theme.palette.accent; ratio: AppState.plan-file-count > 0 ? AppState.execution-attempted-count / AppState.plan-file-count : 0.0; }
                                MetricTile { label: "Moved to Trash"; value: AppState.execution-moved; detail: "Not freed until emptied"; icon-glyph: "\u{f2ed}"; accent-color: Theme.palette.warning; ratio: AppState.execution-moved != "0 B" ? 1.0 : 0.0; }
                                MetricTile { label: "Freed"; value: AppState.execution-freed; detail: "Actually reclaimed"; icon-glyph: "\u{f1f8}"; accent-color: Theme.palette.success; ratio: AppState.execution-freed != "0 B" ? 1.0 : 0.0; }
                                MetricTile { label: "Skipped"; value: AppState.execution-skipped-count; detail: AppState.execution-failed-count + " failed"; icon-glyph: "\u{f05e}"; accent-color: Theme.palette.info; ratio: AppState.execution-skipped-count > 0 || AppState.execution-failed-count > 0 ? 1.0 : 0.0; }
                            }
                        }

                    }
                }

                // The Trash affordance lives in its own compact panel: folding it
                // into the Review card buried it under plan + execution info.
                Panel {
                    VerticalLayout {
                        padding: Theme.spacing-md;
                        HorizontalLayout {
                            spacing: Theme.spacing-md;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: Theme.spacing-xs;
                                Text { text: "Reclaim trashed space"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; font-weight: 700; }
                                Text { text: AppState.trash-status; color: Theme.palette.text-secondary; font-size: Theme.font-size-sm; wrap: word-wrap; }
                            }

                            ActionButton {
                                label: !AppState.trash-has-items && !AppState.empty-trash-pending
                                    ? "Trash is empty"
                                    : (AppState.empty-trash-pending ? "Confirm Empty Trash" : "Empty Trash now");
                                icon-glyph: AppState.empty-trash-pending ? "\u{f00c}" : "\u{f1f8}";
                                button-color: AppState.empty-trash-pending ? Theme.palette.danger : Theme.palette.warning;
                                enabled: !AppState.scanning && !AppState.cleaning && (AppState.trash-has-items || AppState.empty-trash-pending);
                                clicked => {
                                    if AppState.empty-trash-pending {
                                        AppCallbacks.empty-trash();
                                    } else {
                                        AppCallbacks.request-empty-trash-confirmation();
                                    }
                                }
                            }
                        }
                    }
                }

                // Everything reviewable scrolls; the summary + Clean controls
                // above stay fixed so the primary action is always reachable.
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: Theme.spacing-md;

                        // ── Cleanup plan (selectable) ───────────────────────
                        Panel {
                            VerticalLayout {
                                padding: Theme.spacing-sm;
                                // No inter-row spacing: collapsed (zero-height) rows
                                // must not contribute gaps. Rows carry their own height.
                                spacing: 0px;

                                // Column header only makes sense with rows below
                                // it; hiding it when empty stops the "dangling
                                // header + gap + message" broken look.
                                if AppState.plan-action-count > 0: HorizontalLayout {
                                    padding-left: Theme.spacing-md;
                                    padding-right: Theme.spacing-md;
                                    padding-top: Theme.spacing-xs;
                                    padding-bottom: Theme.spacing-sm;
                                    spacing: Theme.spacing-sm;
                                    Rectangle { width: RowColumns.icon-col; }
                                    Rectangle {
                                        width: RowColumns.select-col;
                                        Checkbox {
                                            checked: AppState.plan-all-selected;
                                            enabled: AppState.plan-action-count > 0;
                                            x: 0;
                                            y: (parent.height - self.height) / 2;
                                            toggled => { AppCallbacks.set-all-plan-selection(!AppState.plan-all-selected); }
                                        }
                                    }
                                    Text { text: "NAME"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: "ITEMS"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; font-weight: 700; min-width: RowColumns.items-col; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: "SIZE"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; font-weight: 700; min-width: RowColumns.size-col; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: "SAFETY"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; font-weight: 700; min-width: RowColumns.safety-col; horizontal-alignment: center; vertical-alignment: center; }
                                }

                                if AppState.plan-action-count > 0: Rectangle { height: 1px; background: Theme.palette.border-subtle; }

                                if AppState.plan-action-count == 0: VerticalLayout {
                                    min-height: 220px;
                                    vertical-stretch: 1;
                                    alignment: center;
                                    spacing: Theme.spacing-sm;

                                    FaIcon {
                                        glyph: AppState.scanning || AppState.cleaning ? "\u{f110}" : "\u{f0ae}";
                                        icon-color: Theme.palette.text-muted;
                                        icon-size: Theme.font-size-xl;
                                    }
                                    Text {
                                        text: AppState.scanning || AppState.cleaning ? "Working..." : "No actions yet";
                                        color: Theme.palette.text-secondary;
                                        font-size: Theme.font-size-md;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: AppState.scanning || AppState.cleaning ? "Analyzing scanned files." : "Run a scan to review cleanable actions.";
                                        color: Theme.palette.text-muted;
                                        font-size: Theme.font-size-sm;
                                        horizontal-alignment: center;
                                    }
                                }

                                for row[idx] in AppState.plan-rows: PlanListRow {
                                    kind: row.kind;
                                    row-visible: row.row-visible;
                                    expanded: row.expanded;
                                    name: row.name;
                                    detail: row.detail;
                                    size: row.size;
                                    safety: row.safety;
                                    count: row.count;
                                    selected: row.selected;
                                    partial: row.partial;
                                    toggle-select => { AppCallbacks.plan-row-toggle(idx); }
                                    toggle-expand => { AppCallbacks.plan-row-expand(idx); }
                                }
                            }
                        }

                        // ── Docker (independent of the filesystem scan root) ─
                        if AppState.docker-available: Panel {
                            VerticalLayout {
                                padding: Theme.spacing-sm;
                                spacing: 2px;

                                HorizontalLayout {
                                    padding-left: Theme.spacing-md;
                                    padding-right: Theme.spacing-md;
                                    padding-top: Theme.spacing-xs;
                                    padding-bottom: Theme.spacing-sm;
                                    spacing: Theme.spacing-sm;
                                    FaIcon { glyph: "\u{f395}"; brand: true; icon-color: Theme.palette.docker; icon-size: Theme.font-size-md; width: 22px; }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Docker"; color: Theme.palette.text-primary; font-size: Theme.font-size-sm; font-weight: 700; }
                                        Text { text: AppState.docker-status; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; overflow: elide; }
                                    }
                                    Text { text: AppState.docker-reclaimable; color: Theme.palette.success; font-size: Theme.font-size-sm; font-weight: 700; vertical-alignment: center; }
                                    ActionButton {
                                        label: AppState.docker-cleaning ? "Cleaning..." : "Clean Docker";
                                        icon-glyph: "\u{f2ed}";
                                        button-color: Theme.palette.warning;
                                        min-width: 130px;
                                        enabled: !AppState.docker-cleaning && !AppState.scanning && !AppState.cleaning;
                                        clicked => { AppCallbacks.clean-docker(); }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.palette.border-subtle; }

                                for d[idx] in AppState.docker-rows: Rectangle {
                                    height: 50px;
                                    background: dta.has-hover ? Theme.palette.surface-elevated : transparent;
                                    border-radius: Theme.radius-sm;
                                    dta := TouchArea {
                                        mouse-cursor: d.has-reclaimable ? pointer : default;
                                        clicked => { if (d.has-reclaimable) { AppCallbacks.toggle-docker-selection(idx); } }
                                    }
                                    HorizontalLayout {
                                        padding-left: Theme.spacing-md;
                                        padding-right: Theme.spacing-md;
                                        spacing: Theme.spacing-sm;
                                        Rectangle {
                                            width: RowColumns.select-col;
                                            if d.has-reclaimable: Checkbox {
                                                checked: d.selected;
                                                x: 0;
                                                y: (parent.height - self.height) / 2;
                                                toggled => { AppCallbacks.toggle-docker-selection(idx); }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: d.label; color: Theme.palette.text-primary; font-size: Theme.font-size-sm; font-weight: 600; }
                                            Text { text: d.detail; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; overflow: elide; }
                                        }
                                        Text { text: d.size; color: Theme.palette.text-secondary; font-size: Theme.font-size-sm; font-weight: 600; vertical-alignment: center; horizontal-alignment: right; min-width: RowColumns.size-col; }
                                    }
                                }
                            }
                        }

                        // ── Time Machine local snapshots ─────────────────────
                        // The one flow that CANNOT go to the Trash: an APFS
                        // snapshot is volume metadata, so deletion is permanent.
                        // Rows start unselected and deletion is two-step confirmed.
                        if AppState.snapshot-available: Panel {
                            VerticalLayout {
                                padding: Theme.spacing-sm;
                                spacing: 2px;

                                HorizontalLayout {
                                    padding-left: Theme.spacing-md;
                                    padding-right: Theme.spacing-md;
                                    padding-top: Theme.spacing-xs;
                                    padding-bottom: Theme.spacing-sm;
                                    spacing: Theme.spacing-sm;
                                    FaIcon { glyph: "\u{f1da}"; icon-color: Theme.palette.warning; icon-size: Theme.font-size-md; width: 22px; }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Time Machine local snapshots"; color: Theme.palette.text-primary; font-size: Theme.font-size-sm; font-weight: 700; }
                                        Text { text: AppState.snapshot-status; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; wrap: word-wrap; }
                                    }
                                    if AppState.snapshot-delete-pending: ActionButton {
                                        label: "Cancel";
                                        icon-glyph: "\u{f00d}";
                                        button-color: Theme.palette.info;
                                        enabled: !AppState.snapshot-deleting;
                                        clicked => { AppCallbacks.cancel-snapshot-delete(); }
                                    }
                                    ActionButton {
                                        label: AppState.snapshot-deleting
                                            ? "Deleting..."
                                            : AppState.snapshot-delete-pending
                                                ? "Confirm permanent delete (" + AppState.snapshot-selected-count + ")"
                                                : "Delete selected (" + AppState.snapshot-selected-count + ")";
                                        icon-glyph: AppState.snapshot-delete-pending ? "\u{f00c}" : "\u{f1f8}";
                                        button-color: AppState.snapshot-delete-pending ? Theme.palette.danger : Theme.palette.warning;
                                        min-width: 130px;
                                        enabled: !AppState.snapshot-deleting && !AppState.scanning && !AppState.cleaning && (AppState.snapshot-delete-pending || AppState.snapshot-selected-count > 0);
                                        clicked => {
                                            if AppState.snapshot-delete-pending {
                                                AppCallbacks.confirm-snapshot-delete();
                                            } else {
                                                AppCallbacks.request-snapshot-delete();
                                            }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.palette.border-subtle; }

                                for s[idx] in AppState.snapshot-rows: Rectangle {
                                    height: 50px;
                                    background: sta.has-hover ? Theme.palette.surface-elevated : transparent;
                                    border-radius: Theme.radius-sm;
                                    sta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { AppCallbacks.toggle-snapshot-selection(idx); }
                                    }
                                    HorizontalLayout {
                                        padding-left: Theme.spacing-md;
                                        padding-right: Theme.spacing-md;
                                        spacing: Theme.spacing-sm;
                                        Rectangle {
                                            width: RowColumns.select-col;
                                            Checkbox {
                                                checked: s.selected;
                                                x: 0;
                                                y: (parent.height - self.height) / 2;
                                                toggled => { AppCallbacks.toggle-snapshot-selection(idx); }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: s.label; color: Theme.palette.text-primary; font-size: Theme.font-size-sm; font-weight: 600; }
                                            Text { text: s.identifier; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }

                        // ── Suggestions (review only — never auto-cleaned) ───
                        if AppState.duplicate-count > 0 || AppState.large-item-count > 0 || AppState.screenshot-count > 0 || AppState.installer-count > 0: Panel {
                            VerticalLayout {
                                padding: Theme.spacing-sm;
                                spacing: 2px;

                                HorizontalLayout {
                                    padding-left: Theme.spacing-md;
                                    padding-right: Theme.spacing-md;
                                    padding-top: Theme.spacing-xs;
                                    padding-bottom: Theme.spacing-sm;
                                    spacing: Theme.spacing-sm;
                                    FaIcon { glyph: "\u{f0eb}"; icon-color: Theme.palette.info; icon-size: Theme.font-size-md; width: 22px; }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: "Suggestions"; color: Theme.palette.text-primary; font-size: Theme.font-size-sm; font-weight: 700; }
                                        Text { text: "Review only: not part of the cleanup plan. Click a row to reveal it in Finder, or use Trash to move a single item to the Trash."; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; wrap: word-wrap; }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.palette.border-subtle; }

                                if AppState.duplicate-count > 0: Rectangle { height: Theme.spacing-sm; }

                                if AppState.duplicate-count > 0: Text {
                                    text: "Duplicate files: " + AppState.duplicate-reclaimable + " across " + AppState.duplicate-count + " sets";
                                    color: Theme.palette.text-secondary;
                                    font-size: Theme.font-size-xs;
                                    font-weight: 700;
                                }
                                for s in AppState.duplicate-rows: SuggestionListRow {
                                    title: s.title;
                                    detail: s.detail;
                                    size: s.size;
                                    icon-glyph: s.icon;
                                    deletable: s.deletable;
                                    armed-delete: s.deletable && s.path != "" && s.path == AppState.suggestion-pending-delete-path;
                                    reveal => { AppCallbacks.reveal-in-finder(s.path); }
                                    arm-delete => { AppState.suggestion-pending-delete-path = s.path; }
                                    confirm-delete => {
                                        AppCallbacks.delete-suggestion(s.path);
                                        AppState.suggestion-pending-delete-path = "";
                                    }
                                }

                                if AppState.screenshot-count > 0: Rectangle { height: Theme.spacing-md; }
                                if AppState.screenshot-count > 0: Text {
                                    text: "Screenshots & recordings: " + AppState.screenshot-reclaimable + " across " + AppState.screenshot-count + " files";
                                    color: Theme.palette.text-secondary;
                                    font-size: Theme.font-size-xs;
                                    font-weight: 700;
                                }
                                for s in AppState.screenshot-rows: SuggestionListRow {
                                    title: s.title;
                                    detail: s.detail;
                                    size: s.size;
                                    icon-glyph: s.icon;
                                    deletable: s.deletable;
                                    armed-delete: s.deletable && s.path != "" && s.path == AppState.suggestion-pending-delete-path;
                                    reveal => { AppCallbacks.reveal-in-finder(s.path); }
                                    arm-delete => { AppState.suggestion-pending-delete-path = s.path; }
                                    confirm-delete => {
                                        AppCallbacks.delete-suggestion(s.path);
                                        AppState.suggestion-pending-delete-path = "";
                                    }
                                }

                                if AppState.installer-count > 0: Rectangle { height: Theme.spacing-md; }
                                if AppState.installer-count > 0: Text {
                                    text: "Old installers in Downloads: " + AppState.installer-reclaimable + " across " + AppState.installer-count + " files (re-downloadable)";
                                    color: Theme.palette.text-secondary;
                                    font-size: Theme.font-size-xs;
                                    font-weight: 700;
                                }
                                for s in AppState.installer-rows: SuggestionListRow {
                                    title: s.title;
                                    detail: s.detail;
                                    size: s.size;
                                    icon-glyph: s.icon;
                                    deletable: s.deletable;
                                    armed-delete: s.deletable && s.path != "" && s.path == AppState.suggestion-pending-delete-path;
                                    reveal => { AppCallbacks.reveal-in-finder(s.path); }
                                    arm-delete => { AppState.suggestion-pending-delete-path = s.path; }
                                    confirm-delete => {
                                        AppCallbacks.delete-suggestion(s.path);
                                        AppState.suggestion-pending-delete-path = "";
                                    }
                                }

                                if AppState.large-item-count > 0: Rectangle { height: Theme.spacing-md; }
                                if AppState.large-item-count > 0: Text {
                                    text: "Largest files & folders";
                                    color: Theme.palette.text-secondary;
                                    font-size: Theme.font-size-xs;
                                    font-weight: 700;
                                }
                                for s in AppState.large-item-rows: SuggestionListRow {
                                    title: s.title;
                                    detail: s.detail;
                                    size: s.size;
                                    icon-glyph: s.icon;
                                    deletable: s.deletable;
                                    armed-delete: s.deletable && s.path != "" && s.path == AppState.suggestion-pending-delete-path;
                                    reveal => { AppCallbacks.reveal-in-finder(s.path); }
                                    arm-delete => { AppState.suggestion-pending-delete-path = s.path; }
                                    confirm-delete => {
                                        AppCallbacks.delete-suggestion(s.path);
                                        AppState.suggestion-pending-delete-path = "";
                                    }
                                }
                            }
                        }

                        // ── Held back / needs explicit confirmation ─────────
                        // ML-demoted candidates: never part of one-click cleanup.
                        if AppState.held-count > 0: Panel {
                            VerticalLayout {
                                padding: Theme.spacing-sm;
                                spacing: 2px;

                                HorizontalLayout {
                                    padding-left: Theme.spacing-md;
                                    padding-right: Theme.spacing-md;
                                    padding-top: Theme.spacing-xs;
                                    padding-bottom: Theme.spacing-sm;
                                    spacing: Theme.spacing-sm;
                                    FaIcon { glyph: "\u{f071}"; icon-color: Theme.palette.warning; icon-size: Theme.font-size-sm; width: 22px; }
                                    Text {
                                        text: "Held back / needs explicit confirmation (" + AppState.held-count + ")";
                                        color: Theme.palette.warning;
                                        font-size: Theme.font-size-sm;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: "Excluded from one-click cleanup";
                                        color: Theme.palette.text-muted;
                                        font-size: Theme.font-size-xs;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.palette.border-subtle; }

                                for action in AppState.held-actions: FileRow {
                                    name: action.name;
                                    size: action.size;
                                    safety: action.safety;
                                    icon-glyph: action.action-icon;
                                    count: action.count;
                                    detail: action.detail;
                                }
                            }
                        }
                    }
                }
            }

            // ── Packages (Homebrew / npm / pip / MacPorts) ──────────────────
            if AppState.active-screen == 2: VerticalLayout {
                padding: Theme.spacing-xl;
                spacing: Theme.spacing-md;

                HorizontalLayout {
                    spacing: Theme.spacing-sm;
                    VerticalLayout {
                        spacing: Theme.spacing-xs;
                        horizontal-stretch: 1;
                        Text { text: "Packages"; color: Theme.palette.text-primary; font-size: Theme.font-size-xl; font-weight: 700; }
                        Text { text: AppState.package-status; color: Theme.palette.text-secondary; font-size: Theme.font-size-sm; overflow: elide; }
                    }
                    ActionButton { label: AppState.package-loading ? "Loading..." : "Refresh"; icon-glyph: "\u{f021}"; enabled: !AppState.package-loading && !AppState.package-acting; clicked => { AppCallbacks.refresh-packages(); } }
                    // Activity indicator on the right, next to the action that
                    // started it; Spinner hides itself when nothing is running.
                    Spinner {
                        running: AppState.package-loading || AppState.package-acting || AppState.package-usage-scanning;
                        spinner-size: 16px;
                        y: (parent.height - self.height) / 2;
                    }
                }

                // Indeterminate activity strip: always visible feedback that work
                // is in flight, even when the status line has not changed yet.
                ActivityBar {
                    running: AppState.package-loading || AppState.package-acting || AppState.package-usage-scanning;
                }

                // Manager selector.
                HorizontalLayout {
                    spacing: Theme.spacing-sm;
                    for tab[idx] in AppState.package-tabs: Rectangle {
                        height: 34px;
                        min-width: 96px;
                        border-radius: Theme.radius-sm;
                        background: idx == AppState.active-package-tab ? Theme.palette.accent.with-alpha(0.14) : (mta.has-hover ? Theme.palette.surface-elevated : transparent);
                        border-width: 1px;
                        border-color: idx == AppState.active-package-tab ? Theme.palette.accent : Theme.palette.border;
                        opacity: tab.available ? 1.0 : 0.45;
                        mta := TouchArea { mouse-cursor: pointer; clicked => { AppCallbacks.select-package-manager(idx); } }
                        HorizontalLayout {
                            padding-left: Theme.spacing-md;
                            padding-right: Theme.spacing-md;
                            Text { text: tab.label; color: idx == AppState.active-package-tab ? Theme.palette.accent : Theme.palette.text-secondary; font-size: Theme.font-size-sm; font-weight: idx == AppState.active-package-tab ? 650 : 500; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                // Summary tiles.
                HorizontalLayout {
                    spacing: Theme.spacing-md;
                    MetricTile { label: "Installed"; value: AppState.package-count; detail: AppState.package-total-size + " on disk"; icon-glyph: "\u{f1b3}"; accent-color: Theme.palette.accent; ratio: AppState.package-count > 0 ? 1.0 : 0.0; }
                    MetricTile { label: "Outdated"; value: AppState.package-outdated-count; detail: "updates available"; icon-glyph: "\u{f062}"; accent-color: Theme.palette.warning; ratio: AppState.package-outdated-count > 0 ? 1.0 : 0.0; }
                    MetricTile { label: AppState.package-supports-keepset ? "Removable (unkept)" : "Selected to remove"; value: AppState.package-removable-count; detail: AppState.package-reclaimable + (AppState.package-supports-keepset ? " · " + AppState.package-kept-dep-count + " kept as deps" : ""); icon-glyph: "\u{f2ed}"; accent-color: Theme.palette.success; ratio: AppState.package-removable-count > 0 ? 1.0 : 0.0; }
                }

                // Action card. The guidance and the live status get the full
                // panel width, and the buttons sit in their own row underneath:
                // side by side, three buttons with a fixed minimum width squeezed
                // the left-hand text until it clipped.
                Panel {
                    VerticalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-sm;

                        Text {
                            text: AppState.package-supports-keepset
                                ? "Uncheck packages you don't want; dependencies still needed by kept packages stay."
                                : "Uncheck packages to remove them.";
                            color: Theme.palette.text-secondary;
                            font-size: Theme.font-size-sm;
                            wrap: word-wrap;
                        }

                        if AppState.package-action-status != "": HorizontalLayout {
                            spacing: Theme.spacing-xs;
                            Spinner {
                                running: AppState.package-usage-scanning || AppState.package-acting || AppState.package-loading;
                                spinner-size: 12px;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: AppState.package-action-status;
                                color: Theme.palette.text-muted;
                                font-size: Theme.font-size-xs;
                                wrap: word-wrap;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }

                        if AppState.package-note != "": Text { text: AppState.package-note; color: Theme.palette.warning; font-size: Theme.font-size-xs; wrap: word-wrap; }

                        ActivityBar {
                            running: AppState.package-acting || AppState.package-loading;
                        }

                        HorizontalLayout {
                            spacing: Theme.spacing-md;
                            alignment: end;

                            ActionButton {
                                label: AppState.package-loading
                                    ? "Checking updates..."
                                    : (AppState.package-outdated-count > 0 ? "Update all" : "Up to date");
                                icon-glyph: "\u{f062}";
                                primary: false;
                                enabled: AppState.package-outdated-count > 0 && !AppState.package-acting && !AppState.package-loading;
                                clicked => { AppCallbacks.update-all-packages(); }
                            }
                            ActionButton {
                                label: AppState.package-acting ? "Working..." : "Clean cache";
                                icon-glyph: "\u{f51a}";
                                primary: false;
                                enabled: !AppState.package-acting && !AppState.package-loading;
                                clicked => { AppCallbacks.clean-package-cache(); }
                            }
                            ActionButton {
                                label: AppState.package-remove-pending
                                    ? "Confirm remove (" + AppState.package-removable-count + ")"
                                    : "Remove unkept";
                                icon-glyph: AppState.package-remove-pending ? "\u{f00c}" : "\u{f2ed}";
                                button-color: AppState.package-remove-pending ? Theme.palette.danger : Theme.palette.warning;
                                enabled: !AppState.package-acting && !AppState.package-loading && !AppState.package-usage-scanning && (AppState.package-remove-pending || AppState.package-removable-count > 0);
                                clicked => {
                                    if AppState.package-remove-pending {
                                        AppCallbacks.confirm-remove-packages();
                                    } else {
                                        AppCallbacks.request-remove-packages();
                                    }
                                }
                            }
                        }
                    }
                }

                // Package list.
                Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: Theme.spacing-sm;
                        spacing: 0px;

                        if AppState.package-count > 0: HorizontalLayout {
                            padding-left: Theme.spacing-md;
                            padding-right: Theme.spacing-md;
                            padding-top: Theme.spacing-xs;
                            padding-bottom: Theme.spacing-sm;
                            spacing: Theme.spacing-sm;
                            Rectangle {
                                width: RowColumns.select-col;
                                Checkbox {
                                    checked: AppState.package-removable-count == 0 && AppState.package-count > 0;
                                    enabled: AppState.package-count > 0;
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    toggled => { AppCallbacks.set-all-package-keep(AppState.package-removable-count > 0); }
                                }
                            }
                            Text { text: "PACKAGE"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                            Text { text: "STATUS"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; font-weight: 700; min-width: 116px; horizontal-alignment: center; vertical-alignment: center; }
                            Text { text: "SIZE"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; font-weight: 700; min-width: RowColumns.size-col; horizontal-alignment: right; vertical-alignment: center; }
                        }

                        if AppState.package-count > 0: Rectangle { height: 1px; background: Theme.palette.border-subtle; }

                        if AppState.package-count == 0: VerticalLayout {
                            min-height: 220px;
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: Theme.spacing-sm;
                            Spinner {
                                running: AppState.package-loading;
                                spinner-size: 26px;
                                spinner-color: Theme.palette.text-muted;
                                visible: AppState.package-loading;
                            }
                            FaIcon {
                                glyph: "\u{f1b3}";
                                icon-color: Theme.palette.text-muted;
                                icon-size: Theme.font-size-xl;
                                visible: !AppState.package-loading;
                            }
                            Text { text: AppState.package-loading ? AppState.package-status : (AppState.package-note != "" ? AppState.package-note : "No packages found"); color: Theme.palette.text-secondary; font-size: Theme.font-size-md; font-weight: 600; horizontal-alignment: center; }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                for pkg[idx] in AppState.package-rows: PackageListRow {
                                    name: pkg.name;
                                    version: pkg.version;
                                    size: pkg.size;
                                    kept: pkg.kept;
                                    state: pkg.state;
                                    outdated: pkg.outdated;
                                    used-by-count: pkg.used-by-count;
                                    used-by: pkg.used-by;
                                    acting: AppState.package-acting;
                                    toggle-keep => { AppCallbacks.toggle-package-keep(idx); }
                                    update-now => { AppCallbacks.update-package(pkg.name); }
                                }
                            }
                        }
                    }
                }
            }

            if AppState.active-screen == 3: VerticalLayout {
                padding: Theme.spacing-xl;
                spacing: Theme.spacing-md;

                HorizontalLayout {
                    VerticalLayout {
                        spacing: Theme.spacing-xs;
                        horizontal-stretch: 1;
                        Text { text: "Services"; color: Theme.palette.text-primary; font-size: Theme.font-size-xl; font-weight: 700; }
                        Text { text: AppState.services-status; color: Theme.palette.text-secondary; font-size: Theme.font-size-sm; }
                    }

                    ActionButton {
                        label: "Refresh";
                        icon-glyph: "\u{f021}";
                        enabled: !AppState.loading-services;
                        clicked => { AppCallbacks.refresh-services(); }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.spacing-md;
                    MetricTile { label: "Discovered"; value: AppState.service-count; detail: "launchd and Homebrew"; icon-glyph: "\u{f233}"; accent-color: Theme.palette.info; ratio: AppState.service-count > 0 ? 1.0 : 0.0; }
                    MetricTile { label: "Running"; value: AppState.service-running-count; detail: "active services"; icon-glyph: "\u{f04b}"; accent-color: Theme.palette.success; ratio: AppState.service-count > 0 ? AppState.service-running-count / AppState.service-count : 0.0; }
                    MetricTile { label: "Protected"; value: "System safe"; detail: "protected rows are locked"; icon-glyph: "\u{f023}"; accent-color: Theme.palette.warning; ratio: 1.0; }
                }

                // Filter bar (fixed): narrows the displayed list without touching
                // the discovered/running totals on the metric tiles above.
                HorizontalLayout {
                    spacing: Theme.spacing-md;

                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Filter by name or path...";
                        text <=> AppState.service-filter;
                        edited => { AppCallbacks.apply-service-filter(); }
                    }

                    // Each label+toggle pair is its own 26px row, the exact
                    // height of the toggle track, so the label and the switch sit
                    // on one optical line instead of drifting apart.
                    HorizontalLayout {
                        height: 26px;
                        spacing: Theme.spacing-xs;
                        alignment: start;
                        Text {
                            text: "Startup only";
                            color: Theme.palette.text-secondary;
                            font-size: Theme.font-size-sm;
                            height: 26px;
                            vertical-alignment: center;
                        }
                        Toggle {
                            checked <=> AppState.service-startup-only;
                            toggled => { AppCallbacks.apply-service-filter(); }
                        }
                    }

                    HorizontalLayout {
                        height: 26px;
                        spacing: Theme.spacing-xs;
                        alignment: start;
                        Text {
                            text: "Hide protected";
                            color: Theme.palette.text-secondary;
                            font-size: Theme.font-size-sm;
                            height: 26px;
                            vertical-alignment: center;
                        }
                        Toggle {
                            checked <=> AppState.service-hide-protected;
                            toggled => { AppCallbacks.apply-service-filter(); }
                        }
                    }

                    HorizontalLayout {
                        height: 26px;
                        spacing: Theme.spacing-xs;
                        alignment: start;
                        Text {
                            text: "Running only";
                            color: Theme.palette.text-secondary;
                            font-size: Theme.font-size-sm;
                            height: 26px;
                            vertical-alignment: center;
                        }
                        Toggle {
                            checked <=> AppState.service-running-only;
                            toggled => { AppCallbacks.apply-service-filter(); }
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        Panel {
                            VerticalLayout {
                                padding: Theme.spacing-sm;
                                spacing: 2px;

                                // Column header (muted, uppercase) + divider, with
                                // comfortable top padding so the first row breathes.
                                // Hidden when empty so the empty/loading state reads
                                // as one clean centered block, not a stray header.
                                if AppState.service-count > 0: HorizontalLayout {
                                    padding-left: Theme.spacing-md;
                                    padding-right: Theme.spacing-md;
                                    padding-top: Theme.spacing-sm;
                                    padding-bottom: Theme.spacing-sm;
                                    spacing: Theme.spacing-md;
                                    Rectangle { width: 14px; }
                                    Text { text: "NAME"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; font-weight: 700; horizontal-stretch: 1; }
                                    Text { text: "TYPE"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; font-weight: 700; min-width: 104px; horizontal-alignment: center; }
                                    Text { text: "STATUS"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; font-weight: 700; min-width: 104px; horizontal-alignment: center; }
                                    Text { text: "ACTION"; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; font-weight: 700; min-width: 168px; horizontal-alignment: right; }
                                }

                                if AppState.service-count > 0: Rectangle { height: 1px; background: Theme.palette.border-subtle; }

                                if AppState.service-count == 0: VerticalLayout {
                                    min-height: 220px;
                                    vertical-stretch: 1;
                                    alignment: center;
                                    spacing: Theme.spacing-sm;

                                    FaIcon {
                                        glyph: AppState.loading-services ? "\u{f110}" : "\u{f233}";
                                        icon-color: Theme.palette.text-muted;
                                        icon-size: Theme.font-size-xl;
                                    }
                                    Text {
                                        text: AppState.loading-services ? "Discovering services..." : "No services loaded";
                                        color: Theme.palette.text-secondary;
                                        font-size: Theme.font-size-md;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: AppState.loading-services ? "Querying launchd and Homebrew." : "Refresh to discover launchd and Homebrew services.";
                                        color: Theme.palette.text-muted;
                                        font-size: Theme.font-size-sm;
                                        horizontal-alignment: center;
                                    }
                                }

                                for service in AppState.services: ServiceListRow {
                                    id: service.id;
                                    name: service.name;
                                    kind: service.kind;
                                    status: service.status;
                                    path: service.path;
                                    running: service.running;
                                    protected-service: service.protected-service;
                                    run-at-load: service.run-at-load;
                                    orphaned: service.orphaned;
                                    pending-disable-id: AppState.service-pending-disable-id;
                                    pending-remove-id: AppState.service-pending-remove-id;
                                    pending-delete-id: AppState.service-pending-delete-id;
                                    arm-disable(sid) => {
                                        AppState.service-pending-disable-id = sid;
                                        AppState.service-pending-remove-id = "";
                                        AppState.service-pending-delete-id = "";
                                    }
                                    confirm-disable(sid) => {
                                        AppCallbacks.disable-service(sid);
                                        AppState.service-pending-disable-id = "";
                                    }
                                    arm-remove(sid) => {
                                        AppState.service-pending-remove-id = sid;
                                        AppState.service-pending-disable-id = "";
                                        AppState.service-pending-delete-id = "";
                                    }
                                    confirm-remove(sid) => {
                                        AppCallbacks.remove-service(sid);
                                        AppState.service-pending-remove-id = "";
                                    }
                                    arm-delete(sid) => {
                                        AppState.service-pending-delete-id = sid;
                                        AppState.service-pending-disable-id = "";
                                        AppState.service-pending-remove-id = "";
                                    }
                                    confirm-delete(sid) => {
                                        AppCallbacks.delete-service(sid);
                                        AppState.service-pending-delete-id = "";
                                    }
                                    enable(sid) => { AppCallbacks.enable-service(sid); }
                                }
                            }
                        }
                    }
                }
            }

            if AppState.active-screen == 5: VerticalLayout {
                padding: Theme.spacing-xl;
                spacing: Theme.spacing-lg;

                HorizontalLayout {
                    spacing: Theme.spacing-md;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.spacing-xs;
                        Text { text: "Applications"; color: Theme.palette.text-primary; font-size: Theme.font-size-xl; font-weight: 700; }
                        Text { text: AppState.apps-status; color: Theme.palette.text-secondary; font-size: Theme.font-size-sm; overflow: elide; }
                    }

                    ActionButton {
                        label: AppState.apps-loading ? "Loading..." : "Refresh";
                        icon-glyph: "\u{f021}";
                        enabled: !AppState.apps-loading;
                        clicked => { AppCallbacks.refresh-apps(); }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.spacing-md;
                    vertical-stretch: 1;

                    // ── Left: installed applications ───────────────────────
                    Panel {
                        horizontal-stretch: 5;
                        // The list holds full app names + version/bundle id; give
                        // it a solid floor so names never truncate to "Activ…".
                        min-width: 380px;

                        VerticalLayout {
                            padding: Theme.spacing-sm;
                            spacing: Theme.spacing-sm;

                            LineEdit {
                                placeholder-text: "Filter by name or bundle id...";
                                text <=> AppState.app-filter;
                                edited => { AppCallbacks.apply-app-filter(); }
                            }

                            HorizontalLayout {
                                height: 26px;
                                spacing: Theme.spacing-sm;
                                alignment: start;
                                Toggle {
                                    checked <=> AppState.apps-hide-system;
                                    toggled => { AppCallbacks.apply-app-filter(); }
                                }
                                Text {
                                    text: "Hide system apps";
                                    color: Theme.palette.text-secondary;
                                    font-size: Theme.font-size-sm;
                                    height: 26px;
                                    vertical-alignment: center;
                                }
                            }

                            ScrollView {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    spacing: 2px;
                                    for a in AppState.app-rows: Rectangle {
                                        height: 44px;
                                        border-radius: Theme.radius-sm;
                                        background: a.path == AppState.selected-app-path
                                            ? Theme.palette.accent.with-alpha(0.14)
                                            : (app-row-touch.has-hover ? Theme.palette.surface-elevated : transparent);

                                        app-row-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppCallbacks.select-app(a.path); }
                                        }

                                        HorizontalLayout {
                                            padding-left: Theme.spacing-sm;
                                            padding-right: Theme.spacing-sm;
                                            spacing: Theme.spacing-sm;

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 1px;
                                                HorizontalLayout {
                                                    spacing: Theme.spacing-xs;
                                                    alignment: start;
                                                    Text { text: a.name; color: Theme.palette.text-primary; font-size: Theme.font-size-sm; font-weight: 600; overflow: elide; vertical-alignment: center; }
                                                    // Both pills share the row's
                                                    // natural height, so they line
                                                    // up with the app name without
                                                    // any absolute positioning.
                                                    if a.app-store: Badge {
                                                        label: "App Store";
                                                        badge-color: Theme.palette.info;
                                                        min-width: 58px;
                                                    }
                                                    if a.brew: Badge {
                                                        label: "brew";
                                                        badge-color: Theme.palette.warning;
                                                        min-width: 42px;
                                                    }
                                                }
                                                Text { text: a.version == "" ? a.bundle-id : a.version + " · " + a.bundle-id; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; overflow: elide; }
                                            }

                                            Rectangle {
                                                width: 16px;
                                                FaIcon {
                                                    glyph: "\u{f023}";
                                                    icon-color: Theme.palette.text-muted;
                                                    icon-size: Theme.font-size-xs;
                                                    visible: a.protected;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }

                                            Text {
                                                text: a.size;
                                                color: Theme.palette.text-secondary;
                                                font-size: Theme.font-size-xs;
                                                vertical-alignment: center;
                                                width: 64px;
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── Right: leftover review + uninstall ─────────────────
                    Panel {
                        horizontal-stretch: 6;

                        VerticalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-sm;

                            if AppState.selected-app-name == "": VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;
                                Text {
                                    text: "Select an application to review everything it would leave behind: support files, caches, preferences, launch items, containers, and helpers.";
                                    color: Theme.palette.text-muted;
                                    font-size: Theme.font-size-sm;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                }
                            }

                            if AppState.selected-app-name != "": VerticalLayout {
                                vertical-stretch: 1;
                                spacing: Theme.spacing-sm;

                                HorizontalLayout {
                                    spacing: Theme.spacing-sm;
                                    Text { text: "Uninstall " + AppState.selected-app-name; color: Theme.palette.text-primary; font-size: Theme.font-size-lg; font-weight: 700; horizontal-stretch: 1; overflow: elide; }
                                    Spinner {
                                        running: AppState.leftover-loading || AppState.uninstalling;
                                        spinner-size: 14px;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: AppState.uninstalling
                                            ? "Moving items to the Trash..."
                                            : (AppState.leftover-loading
                                                ? "Scanning leftovers..."
                                                : AppState.leftover-total + " across " + AppState.leftover-count + " items");
                                        color: Theme.palette.text-secondary;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                    }
                                }

                                ActivityBar {
                                    running: AppState.leftover-loading || AppState.uninstalling;
                                }

                                Text {
                                    text: "Review what gets moved to the Trash. Items marked with a lock are owned by another account (App Store installs): moving them asks for the administrator password once and they still land in the Trash.";
                                    color: Theme.palette.text-muted;
                                    font-size: Theme.font-size-xs;
                                    wrap: word-wrap;
                                }

                                // Outcome of the last uninstall attempt. Kept in the
                                // panel (not only in the page header) so the result
                                // is visible right where the user acted.
                                if AppState.apps-status != "": Text {
                                    text: AppState.apps-status;
                                    color: Theme.palette.text-secondary;
                                    font-size: Theme.font-size-xs;
                                    wrap: word-wrap;
                                }

                                Rectangle { height: 1px; background: Theme.palette.border-subtle; }

                                ScrollView {
                                    vertical-stretch: 1;

                                    VerticalLayout {
                                        spacing: 2px;
                                        for row[i] in AppState.leftover-rows: Rectangle {
                                            height: 40px;
                                            border-radius: Theme.radius-sm;
                                            background: leftover-touch.has-hover ? Theme.palette.surface-elevated : transparent;

                                            leftover-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { AppCallbacks.toggle-leftover(i); }
                                            }

                                            HorizontalLayout {
                                                padding-left: Theme.spacing-sm;
                                                padding-right: Theme.spacing-sm;
                                                spacing: Theme.spacing-sm;

                                                Rectangle {
                                                    width: 20px;
                                                    Checkbox {
                                                        checked: row.selected;
                                                        enabled: !AppState.uninstalling;
                                                        y: (parent.height - self.height) / 2;
                                                        toggled => { AppCallbacks.toggle-leftover(i); }
                                                    }
                                                }

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 1px;
                                                    Text { text: row.name; color: Theme.palette.text-primary; font-size: Theme.font-size-sm; overflow: elide; }
                                                    Text { text: row.path; color: Theme.palette.text-muted; font-size: Theme.font-size-xs; overflow: elide; }
                                                }

                                                Text {
                                                    text: row.kind;
                                                    color: Theme.palette.text-secondary;
                                                    font-size: Theme.font-size-xs;
                                                    vertical-alignment: center;
                                                }

                                                Rectangle {
                                                    width: 14px;
                                                    FaIcon {
                                                        glyph: "\u{f023}";
                                                        icon-color: Theme.palette.warning;
                                                        icon-size: Theme.font-size-xs;
                                                        visible: row.admin;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }

                                                Text {
                                                    text: row.size;
                                                    color: Theme.palette.text-secondary;
                                                    font-size: Theme.font-size-xs;
                                                    vertical-alignment: center;
                                                    width: 64px;
                                                    horizontal-alignment: right;
                                                }
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: Theme.spacing-md;

                                    if !AppState.uninstall-pending: ActionButton {
                                        label: AppState.uninstalling ? "Uninstalling..." : "Uninstall...";
                                        icon-glyph: "\u{f2ed}";
                                        button-color: Theme.palette.danger;
                                        enabled: AppState.leftover-count > 0 && !AppState.leftover-loading && !AppState.uninstalling;
                                        clicked => { AppState.uninstall-pending = true; }
                                    }

                                    if AppState.uninstall-pending: ActionButton {
                                        label: "Confirm: move to Trash";
                                        icon-glyph: "\u{f00c}";
                                        button-color: Theme.palette.danger;
                                        enabled: !AppState.uninstalling;
                                        clicked => { AppCallbacks.confirm-uninstall(); }
                                    }

                                    if AppState.uninstall-pending: ActionButton {
                                        label: "Cancel";
                                        primary: false;
                                        enabled: !AppState.uninstalling;
                                        clicked => { AppState.uninstall-pending = false; }
                                    }

                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                }
            }

            // ── Security: read-only supply-chain scan of installed packages,
            // diffed against the trusted baseline. Detection + notification
            // only — this screen has NO destructive affordance; "Trust"
            // updates the baseline METADATA file, never a package.
            if AppState.active-screen == 6: VerticalLayout {
                padding: Theme.spacing-xl;
                spacing: Theme.spacing-lg;

                HorizontalLayout {
                    spacing: Theme.spacing-md;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.spacing-xs;
                        Text { text: "Security"; color: Theme.palette.text-primary; font-size: Theme.font-size-xl; font-weight: 700; }
                        Text {
                            text: AppState.security-scanning
                                ? "Scanning installed packages... " + AppState.security-progress
                                : (AppState.security-has-report
                                    ? "Changes since your trusted baseline. Read-only: nothing is removed or changed."
                                    : "First scan records your packages as a trusted baseline; later scans flag only changes.");
                            color: Theme.palette.text-secondary;
                            font-size: Theme.font-size-sm;
                            overflow: elide;
                        }
                    }

                    if AppState.security-has-report && !AppState.security-scanning && AppState.security-flagged-count > 0: ActionButton {
                        label: "Trust all shown";
                        icon-glyph: "\u{f058}";
                        primary: false;
                        clicked => { AppCallbacks.security-trust-all(); }
                    }

                    if AppState.security-has-report && !AppState.security-scanning: ActionButton {
                        label: "Re-establish baseline";
                        icon-glyph: "\u{f021}";
                        primary: false;
                        clicked => { AppCallbacks.security-establish-baseline(); }
                    }

                    ActionButton {
                        label: AppState.security-scanning
                            ? "Scanning..."
                            : (AppState.security-has-report ? "Rescan" : "Scan installed packages");
                        icon-glyph: "\u{f132}";
                        enabled: !AppState.security-scanning;
                        clicked => { AppCallbacks.start-security-scan(); }
                    }
                }

                // Idle state: explain the baseline + diff model before the
                // first run.
                if !AppState.security-scanning && !AppState.security-has-report: Panel {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: Theme.spacing-xl;
                        spacing: Theme.spacing-md;
                        alignment: center;

                        FaIcon {
                            glyph: "\u{f132}";
                            icon-color: Theme.palette.accent;
                            icon-size: 34px;
                        }
                        Text {
                            text: "Baseline your packages, then watch for changes";
                            color: Theme.palette.text-primary;
                            font-size: Theme.font-size-lg;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Your first scan records every installed package (global npm/pnpm/bun/yarn packages, Python site-packages, and VS Code/Cursor extensions) as a trusted baseline, so legitimate tools like npm and pip are not treated as threats.";
                            color: Theme.palette.text-secondary;
                            font-size: Theme.font-size-sm;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Later scans flag only what changed: new packages, updated packages, and, the highest signal, packages whose contents changed without a version bump (the npm-worm injection signature).";
                            color: Theme.palette.text-secondary;
                            font-size: Theme.font-size-sm;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "The scan is read-only: Cleanton only reports what it finds; it never removes or changes a package.";
                            color: Theme.palette.text-muted;
                            font-size: Theme.font-size-xs;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Progress state: packages-scanned counter + live bar.
                if AppState.security-scanning: Panel {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: Theme.spacing-xl;
                        spacing: Theme.spacing-md;
                        alignment: center;

                        Text {
                            text: "Scanning... " + AppState.security-progress;
                            color: Theme.palette.text-primary;
                            font-size: Theme.font-size-lg;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            alignment: center;
                            ProgressBar {
                                width: 46%;
                                progress: AppState.security-progress-ratio;
                            }
                        }
                        Text {
                            text: "Fingerprinting each package and analyzing it with the static supply-chain scanner. Nothing is removed or modified during the scan.";
                            color: Theme.palette.text-muted;
                            font-size: Theme.font-size-sm;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Results state: metric tiles + tone banner + the diff.
                if !AppState.security-scanning && AppState.security-has-report: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: Theme.spacing-md;

                    // Summary counts, same tile row style as the Dashboard.
                    HorizontalLayout {
                        spacing: Theme.spacing-md;

                        MetricTile {
                            horizontal-stretch: 1;
                            label: "Known";
                            icon-glyph: "\u{f058}";
                            accent-color: Theme.palette.success;
                            value: AppState.security-known-count;
                            detail: "unchanged since baseline";
                        }
                        MetricTile {
                            horizontal-stretch: 1;
                            label: "New";
                            icon-glyph: "\u{f067}";
                            accent-color: Theme.palette.accent;
                            value: AppState.security-new-count;
                            detail: "not in baseline yet";
                        }
                        MetricTile {
                            horizontal-stretch: 1;
                            label: "Updated";
                            icon-glyph: "\u{f021}";
                            accent-color: Theme.palette.info;
                            value: AppState.security-updated-count;
                            detail: "version bumped";
                        }
                        MetricTile {
                            horizontal-stretch: 1;
                            label: "Tampered?";
                            icon-glyph: "\u{f071}";
                            accent-color: Theme.palette.danger;
                            value: AppState.security-tamper-count;
                            detail: "changed, no version bump";
                        }
                        MetricTile {
                            horizontal-stretch: 1;
                            label: "Critical";
                            icon-glyph: "\u{f188}";
                            accent-color: Theme.palette.danger;
                            value: AppState.security-critical-count;
                            detail: "review first";
                        }
                    }

                    // Tone banner: green when safe, neutral info for
                    // uncorroborated notices, colored only for corroborated
                    // alerts/tampers. Same copy as the TUI and the CLI.
                    Rectangle {
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: (AppState.security-banner-tone == "danger"
                            ? Theme.palette.danger
                            : (AppState.security-banner-tone == "warning"
                                ? Theme.palette.warning
                                : (AppState.security-banner-tone == "info"
                                    ? Theme.palette.info
                                    : Theme.palette.success))).with-alpha(0.35);
                        background: (AppState.security-banner-tone == "danger"
                            ? Theme.palette.danger
                            : (AppState.security-banner-tone == "warning"
                                ? Theme.palette.warning
                                : (AppState.security-banner-tone == "info"
                                    ? Theme.palette.info
                                    : Theme.palette.success))).with-alpha(0.12);
                        height: sec-banner-layout.preferred-height;

                        sec-banner-layout := HorizontalLayout {
                            padding: Theme.spacing-md;
                            spacing: Theme.spacing-md;

                            FaIcon {
                                glyph: AppState.security-banner-tone == "danger"
                                    ? "\u{f071}"
                                    : (AppState.security-banner-tone == "warning"
                                        ? "\u{f06a}"
                                        : (AppState.security-banner-tone == "info" ? "\u{f05a}" : "\u{f058}"));
                                icon-color: AppState.security-banner-tone == "danger"
                                    ? Theme.palette.danger
                                    : (AppState.security-banner-tone == "warning"
                                        ? Theme.palette.warning
                                        : (AppState.security-banner-tone == "info"
                                            ? Theme.palette.info
                                            : Theme.palette.success));
                                icon-size: Theme.font-size-lg;
                                width: 26px;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;

                                Text {
                                    text: AppState.security-headline;
                                    color: AppState.security-banner-tone == "danger"
                                        ? Theme.palette.danger
                                        : (AppState.security-banner-tone == "warning"
                                            ? Theme.palette.warning
                                            : (AppState.security-banner-tone == "info"
                                                ? Theme.palette.info
                                                : Theme.palette.success));
                                    font-size: Theme.font-size-md;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: AppState.security-summary;
                                    color: Theme.palette.text-secondary;
                                    font-size: Theme.font-size-xs;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // Safe state: nothing surfaced.
                    if AppState.security-flagged-count == 0: Panel {
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: Theme.spacing-xl;
                            alignment: center;
                            spacing: Theme.spacing-sm;

                            FaIcon {
                                glyph: "\u{f132}";
                                icon-color: Theme.palette.success;
                                icon-size: 34px;
                            }
                            Text {
                                text: AppState.security-baseline-established
                                    ? "Baseline established"
                                    : "No changes since last baseline";
                                color: Theme.palette.success;
                                font-size: Theme.font-size-lg;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: AppState.security-baseline-established
                                    ? "Your installed packages are now the trusted reference. Future scans flag only new, updated, or tampered packages."
                                    : "Every package is byte-identical to the set you trusted (" + AppState.security-known-count + " known). Rescan any time, for example after installing or updating packages.";
                                color: Theme.palette.text-muted;
                                font-size: Theme.font-size-sm;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // The diff: surfaced packages, worst first (same-version
                    // tampers and malicious verdicts on top).
                    if AppState.security-flagged-count > 0: Panel {
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: Theme.spacing-sm;
                            spacing: Theme.spacing-sm;

                            Text {
                                text: "Surfaced packages (" + AppState.security-flagged-count + "): corroborated alerts first, neutral notices below. Review each package at its path; if you did not expect it, remove or reinstall it with its package manager. Trusting a package only updates the baseline file.";
                                color: Theme.palette.text-secondary;
                                font-size: Theme.font-size-xs;
                                wrap: word-wrap;
                            }

                            ScrollView {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    spacing: Theme.spacing-sm;

                                    for row[row-index] in AppState.security-rows: Rectangle {
                                        border-radius: Theme.radius-sm;
                                        border-width: 1px;
                                        border-color: row.tamper ? Theme.palette.danger.with-alpha(0.55) : Theme.palette.border-subtle;
                                        background: Theme.palette.surface-elevated;
                                        height: sec-row-layout.preferred-height;

                                        sec-row-layout := HorizontalLayout {
                                            padding: Theme.spacing-sm;
                                            spacing: Theme.spacing-sm;

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 3px;

                                                HorizontalLayout {
                                                    spacing: Theme.spacing-sm;

                                                    // Change-kind chip: the same-version tamper is the bold red alarm.
                                                    Badge {
                                                        label: row.change;
                                                        badge-color: row.tamper
                                                            ? Theme.palette.danger
                                                            : (row.change == "updated" ? Theme.palette.info : Theme.palette.accent);
                                                    }
                                                    // Assessment chip: the verdict for ALERT rows only; notice rows get
                                                    // the neutral info badge — a raw heuristic verdict never goes red.
                                                    Badge {
                                                        label: row.assessment-label;
                                                        badge-color: !row.alert
                                                            ? Theme.palette.info
                                                            : (row.assessment-label == "malicious"
                                                                ? Theme.palette.danger
                                                                : (row.assessment-label == "suspicious" ? Theme.palette.warning : Theme.palette.success));
                                                    }
                                                    Text {
                                                        text: row.version == "" ? row.name : row.name + " " + row.version;
                                                        color: Theme.palette.text-primary;
                                                        font-size: Theme.font-size-sm;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: row.severity == "-" ? "" : "severity " + row.severity + " · score " + row.score;
                                                        color: row.critical
                                                            ? Theme.palette.danger
                                                            : (row.alert ? Theme.palette.warning : Theme.palette.text-muted);
                                                        font-size: Theme.font-size-xs;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                Text {
                                                    text: row.source + " · " + row.path;
                                                    color: Theme.palette.text-muted;
                                                    font-size: Theme.font-size-xs;
                                                    overflow: elide;
                                                }

                                                // Shared change-kind explanation (engine copy).
                                                Text {
                                                    text: row.notice;
                                                    color: row.tamper ? Theme.palette.danger : Theme.palette.text-secondary;
                                                    font-size: Theme.font-size-xs;
                                                    font-weight: row.tamper ? 700 : 400;
                                                    wrap: word-wrap;
                                                }

                                                // Notice rows: raw verdict as muted detail only (engine copy).
                                                if row.heuristic != "": Text {
                                                    text: row.heuristic;
                                                    color: Theme.palette.text-muted;
                                                    font-size: Theme.font-size-xs;
                                                    wrap: word-wrap;
                                                }

                                                if row.findings != "": Text {
                                                    text: row.findings;
                                                    color: row.alert ? Theme.palette.text-secondary : Theme.palette.text-muted;
                                                    font-size: Theme.font-size-xs;
                                                    wrap: word-wrap;
                                                }

                                                // Recommended next steps (shared engine copy). Advisory:
                                                // the user runs these; Cleanton removes nothing here.
                                                Rectangle {
                                                    border-radius: Theme.radius-sm;
                                                    background: (row.alert ? Theme.palette.warning : Theme.palette.info).with-alpha(0.08);
                                                    height: sec-action-layout.preferred-height;

                                                    sec-action-layout := VerticalLayout {
                                                        padding: Theme.spacing-xs;
                                                        spacing: 2px;

                                                        Text {
                                                            text: "Recommended: " + row.action-label;
                                                            color: row.alert ? Theme.palette.warning : Theme.palette.info;
                                                            font-size: Theme.font-size-xs;
                                                            font-weight: 700;
                                                        }
                                                        Text {
                                                            text: row.actions;
                                                            color: Theme.palette.text-secondary;
                                                            font-size: Theme.font-size-xs;
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;

                                                ActionButton {
                                                    label: "Trust";
                                                    icon-glyph: "\u{f058}";
                                                    primary: false;
                                                    clicked => { AppCallbacks.security-trust-package(row-index); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: AppState.security-known-count + " known package(s) unchanged since the baseline are hidden.";
                                color: Theme.palette.text-muted;
                                font-size: Theme.font-size-xs;
                            }
                        }
                    }
                }
            }

            if AppState.active-screen == 4: VerticalLayout {
                padding: Theme.spacing-xl;
                spacing: Theme.spacing-lg;

                VerticalLayout {
                    spacing: Theme.spacing-xs;
                    Text { text: "Settings"; color: Theme.palette.text-primary; font-size: Theme.font-size-xl; font-weight: 700; }
                    Text { text: "Changes apply to the next scan. Save to persist them to disk."; color: Theme.palette.text-secondary; font-size: Theme.font-size-sm; }
                }

                // Only the form scrolls; the title above and the action row
                // below stay fixed so Save / Reset are always reachable.
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: Theme.spacing-lg;

                        // ── Scan section ────────────────────────────────────
                        Panel {
                            VerticalLayout {
                                padding: Theme.spacing-lg;
                                spacing: Theme.spacing-md;

                                SectionHeader { text: "SCAN"; }

                                SettingsField {
                                    label: "Default scan root";
                                    description: "The directory Cleanton scans. Use ~ for your home folder.";
                                    LineEdit {
                                        width: 320px;
                                        placeholder-text: "~";
                                        text <=> AppState.setting-default-root;
                                    }
                                }
                                Divider {}

                                SettingsField {
                                    label: "Max scan depth";
                                    description: "How many directory levels deep to descend.";
                                    SpinBox {
                                        width: 130px;
                                        minimum: 0;
                                        maximum: 64;
                                        value <=> AppState.setting-max-depth;
                                    }
                                }
                                Divider {}

                                SettingsField {
                                    label: "Scanner threads";
                                    description: "Parallel worker threads. 0 lets Cleanton choose automatically.";
                                    SpinBox {
                                        width: 130px;
                                        minimum: 0;
                                        maximum: 64;
                                        value <=> AppState.setting-threads;
                                    }
                                }
                            }
                        }

                        // ── Behaviour section ───────────────────────────────
                        Panel {
                            VerticalLayout {
                                padding: Theme.spacing-lg;
                                spacing: Theme.spacing-md;

                                SectionHeader { text: "BEHAVIOUR"; }

                                SettingsField {
                                    label: "Follow symlinks";
                                    description: "Traverse symbolic links while scanning.";
                                    Toggle { checked <=> AppState.setting-follow-symlinks; }
                                }
                                Divider {}

                                SettingsField {
                                    label: "Respect .gitignore";
                                    description: "Skip files ignored by Git in scanned repositories.";
                                    Toggle { checked <=> AppState.setting-respect-gitignore; }
                                }
                                Divider {}

                                SettingsField {
                                    label: "Exclude cloud storage";
                                    description: "Skip iCloud Drive, Dropbox and similar synced roots.";
                                    Toggle { checked <=> AppState.setting-exclude-cloud; }
                                }
                                Divider {}

                                SettingsField {
                                    label: "Exclude external volumes";
                                    description: "Limit scanning to the boot volume.";
                                    Toggle { checked <=> AppState.setting-exclude-volumes; }
                                }
                                Divider {}

                                SettingsField {
                                    label: "ML classification";
                                    description: "Use the on-device model to score cleanup candidates.";
                                    Toggle { checked <=> AppState.setting-ml; }
                                }
                            }
                        }

                        // ── About ───────────────────────────────────────────
                        Panel {
                            VerticalLayout {
                                padding: Theme.spacing-lg;
                                spacing: Theme.spacing-md;

                                SectionHeader { text: "ABOUT"; }

                                SettingsField {
                                    label: "Version";
                                    description: "Cleanton version of this build.";
                                    Text {
                                        text: AppState.app-version == "" ? "unknown" : "v" + AppState.app-version;
                                        color: Theme.palette.text-primary;
                                        font-size: Theme.font-size-sm;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                                Divider {}

                                SettingsField {
                                    label: "Engine";
                                    description: "Recipe-driven scanner with on-device classification.";
                                    Text {
                                        text: "local";
                                        color: Theme.palette.text-secondary;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // ── Safety limits ───────────────────────────────────
                        Panel {
                            VerticalLayout {
                                padding: Theme.spacing-lg;
                                spacing: Theme.spacing-md;

                                SectionHeader { text: "SAFETY LIMITS"; }

                                SettingsField {
                                    label: "Max per cleanup (GB)";
                                    description: "Refuse a single cleanup run larger than this. Raise it to reclaim big build caches at once.";
                                    SpinBox {
                                        width: 130px;
                                        minimum: 1;
                                        maximum: 100000;
                                        value <=> AppState.setting-max-run-gb;
                                    }
                                }
                                Divider {}

                                SettingsField {
                                    label: "Max per item (GB)";
                                    description: "Refuse any single file or folder larger than this.";
                                    SpinBox {
                                        width: 130px;
                                        minimum: 1;
                                        maximum: 100000;
                                        value <=> AppState.setting-max-action-gb;
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Actions ─────────────────────────────────────────────────
                HorizontalLayout {
                    spacing: Theme.spacing-md;

                    ActionButton {
                        label: "Save";
                        icon-glyph: "\u{f0c7}";
                        clicked => { AppCallbacks.save-settings(); }
                    }
                    ActionButton {
                        label: "Reset to defaults";
                        icon-glyph: "\u{f0e2}";
                        primary: false;
                        clicked => { AppCallbacks.reset-settings(); }
                    }

                    Text {
                        text: AppState.setting-save-status;
                        color: Theme.palette.text-muted;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
